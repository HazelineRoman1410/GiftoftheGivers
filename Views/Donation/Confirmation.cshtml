@model GiftoftheGivers.Models.Donation
@{
    ViewData["Title"] = "Donation Confirmation";
}

<div class="page active">
    <div class="donate-section">
        <div class="success-screen">
            <div class="success-icon">✓</div>
            <h2>Donation Recorded!</h2>
            <p>Thank you for your generous contribution to disaster relief.</p>
        </div>
        <div class="tax-cert" id="taxCertificate">
            <h3>Gift of the Givers Foundation</h3>
            <p class="ref">Tax Deduction Certificate (Section 18A) — Prototype Simulation</p>
            <div class="amount">@Model.FormattedAmount</div>
            <div class="details">
                <p><strong>Reference:</strong> @Model.ReferenceNumber</p>
                <p><strong>Date:</strong> @Model.DateSubmitted.ToString("dd MMMM yyyy")</p>
                <p><strong>Donor:</strong> @Model.DonorName</p>
                <p><strong>Type:</strong> @(Model.DonationType == GiftoftheGivers.Models.DonationType.OnceOff ? "Once-off" : "Monthly Recurring")</p>
                <p><strong>Project:</strong> @Model.Project</p>
            </div>
            <p style="font-size:12px; color:var(--text-muted); margin-top:16px;">
                <strong>Note:</strong> This certificate is a simulated placeholder for prototype purposes.
                In production, this will be generated by an Azure Function (HTTP trigger) that returns a real
                Section 18A certificate as a downloadable PDF. No real tax document has been issued.
            </p>
        </div>
        <div style="text-align:center; margin-top:24px;">
            <a asp-action="Create" class="btn btn-accent">Make Another Donation</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline" style="border-color:var(--border); color:var(--text-secondary); margin-left:8px;">Return Home</a>
        </div>
    </div>
</div>