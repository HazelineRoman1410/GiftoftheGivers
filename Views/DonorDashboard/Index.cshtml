@model List<GiftoftheGivers.Models.Donation>
@{
    ViewData["Title"] = "My Donations";
}

<div class="page active">
    <section class="section">
        <div class="section-header"><h2>My Donations</h2><p>Your donation history and tax certificates.</p></div>
        <div style="margin-bottom:24px;"><a asp-controller="Donation" asp-action="Create" class="btn btn-accent">Make a Donation</a></div>

        @if (!Model.Any())
        {
            <p style="font-size:14px; color:var(--text-muted); padding:20px 0;">No donations yet. Make your first donation to see it here.</p>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>Date</th><th>Amount</th><th>Project</th><th>Type</th><th>Certificate</th></tr></thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@d.DateSubmitted.ToString("yyyy-MM-dd")</td>
                            <td><strong>@d.FormattedAmount</strong></td>
                            <td>@d.Project</td>
                            <td>@(d.DonationType == GiftoftheGivers.Models.DonationType.OnceOff ? "Once-off" : "Recurring")</td>
                            <td><a asp-controller="Donation" asp-action="Confirmation" asp-route-id="@d.Id" style="color:var(--primary); font-weight:600; font-size:13px;">📄 @d.ReferenceNumber</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>
