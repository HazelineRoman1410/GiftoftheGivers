@model GiftoftheGivers.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="page active">
    <div class="form-page">
        <div class="form-container">
            <h2>Welcome Back</h2>
            <p class="form-sub">Sign in to access your dashboard.</p>
            <div class="form-tabs">
                <div class="form-tab active">Sign In</div>
                <a asp-action="Register" class="form-tab" style="text-decoration:none;">Register</a>
            </div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;"></div>
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="you@email.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Role"></label>
                    <select asp-for="Role">
                        <option value="Employee">Employee</option>
                        <option value="Donor">Donor</option>
                    </select>
                </div>
                <button type="submit" class="form-submit">Sign In</button>
                <p class="form-footer">Demo Employee account: employee@giftofthegivers.org / Employee@123</p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
